<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/widget_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Nimbus" />

    <TextView
        android:id="@+id/widget_temperature"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        android:text="--°C" />

    <TextView
        android:id="@+id/widget_condition"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#E0E6EC"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Abre la app para actualizar" />

    <TextView
        android:id="@+id/widget_updated_at"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#A7B4C2"
        android:textSize="10sp"
        android:text="" />
</LinearLayout>
